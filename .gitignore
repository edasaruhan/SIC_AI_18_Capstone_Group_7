# Local data must never be committed.
/data/clean/
/data/derived/
/docs/reference/provider/*
!/docs/reference/provider/.gitkeep

# Credentials and machine-local settings.
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# Environments, caches and logs.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.idea/
.vscode/
.DS_Store
Thumbs.db
*.log
/tmp/
/release/

# Historical refits can be reproduced locally; only the final model is published.
/models/legacy_reference.joblib
